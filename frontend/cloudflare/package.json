{
  "name": "@news-sentry/cloudflare-workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "test": "node --experimental-strip-types --test tests/*.test.mts",
    "typecheck:reader": "tsc --project tsconfig.reader.json",
    "wrangler-types": "wrangler types",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env=\"\"",
    "tail": "wrangler tail",
    "db:init": "wrangler d1 execute ns-db --file=db/schema.sql",
    "db:init:dev": "wrangler d1 execute ns-db-dev --file=db/schema.sql",
    "build:frontend": "cd ../.. && npm run build --workspace=admin && npm run build --workspace=public",
    "pages:deploy": "wrangler pages deploy ../../dist/cloudflare"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/turndown": "5.0.6",
    "typescript": "5.9.3",
    "wrangler": "4.114.0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@mozilla/readability": "0.6.0",
    "linkedom": "0.18.12",
    "marked": "18.1.3",
    "turndown": "7.2.4"
  }
}
